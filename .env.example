PORT=8787
HORIZON_URL=https://horizon.stellar.org
AQUARIUS_URL=https://amm-api.aqua.network
RPC_URL=https://mainnet.sorobanrpc.com   # Soroban quotes, simulation, submit and status. Public endpoint with unknown rate limits: use your own provider for real traffic.
SOURCE_TIMEOUT_MS=8000   # per venue; a cold process needs about 5s for its first quote
SLUICE_IPV4_FIRST=0   # set 1 if fetch fails with ETIMEDOUT (broken IPv6 route)
# SLUICE_DNS_CACHE=0   # turn off the in-process name-lookup cache and leave resolution entirely to the system
# SCORED_ASSETS=   # comma separated CODE:ISSUER stablecoins to score. Unset: USDC, PYUSD, USDGLO, ZUSD. Empty: scoring off.
# BLEND_POOLS=   # comma separated CONTRACT:Display name. Unset: the verified Blend Fixed Pool V2.
# DISABLED_VENUES=   # comma separated venue ids (classic-path, aquarius, soroswap, phoenix, comet) to switch off
SLUICE_ROUTER_CONTRACT=   # deployed Sluice router contract id; enables atomic multi-venue Soroban chains. Leave empty on mainnet: the contract is unaudited.
# VITE_REPO_URL=   # build-time, web app only: where the footer's "Source code" link points (default: github.com/funmilayo-ui/sluice)
# VITE_WALLETCONNECT_PROJECT_ID=   # build-time, web app only: a Reown (WalletConnect) project id; adds WalletConnect to the wallet list

# --- Settlement orders (testnet prototype). Off unless ORDERS_SETTLE_CONTRACT, _RPC_URL, _HORIZON_URL, _NETWORK_PASSPHRASE, _MAC_SECRET and one solver setup (below) are set.
# Separate from the mainnet settings above. The public network is refused (ORDERS_MAINNET_REFUSED) until the settle contract is audited:
# there is no override, here or in the solver service. See README "Settlement orders".
# ORDERS_SETTLE_CONTRACT=   # deployed contracts/settle id (C...)
# ORDERS_RPC_URL=   # Soroban RPC of the order network, e.g. https://soroban-testnet.stellar.org
# ORDERS_HORIZON_URL=   # Horizon of the same network, e.g. https://horizon-testnet.stellar.org. Prices the Classic hedge and reads trustlines
# ORDERS_NETWORK_PASSPHRASE=   # e.g. "Test SDF Network ; September 2015"
# ORDERS_MAC_SECRET=   # at least 16 random characters; signs order ids so the server needs no database. Rotating it invalidates prepared orders
# ORDERS_FEE_OUT_PER_XLM=0.1   # token_out per 1 XLM, to price the solver's fees when it pays out a non-XLM asset (testnet has no market to read)
# ORDERS_MAX_ORDER_IN=1000   # largest order the solver takes on, in whole units of the asset sold
# ORDERS_HEDGE_SLIPPAGE_BPS=50   # assumed hedge slippage; also the hedge payment's on-chain minimum
# ORDERS_MIN_PROFIT_BPS=20   # profit the solver requires after fees, in bps of the hedge proceeds
# ORDERS_IMPROVEMENT_BPS=5000   # share of the surplus above the signed minimum that the solver hands to the user
# ORDERS_MIN_DEADLINE_BUFFER_SEC=60   # refuse an order with less than this left before its deadline

# Which solver fills the orders. REMOTE is the production path: the solver is its own service (packages/solver, SOLVER_* below) with
# its own key; the API holds only its address, URL and a shared token, and CANNOT sign as the solver. Setting a secret in remote mode is refused.
# ORDERS_SOLVER_MODE=remote   # remote | local. Unset: a secret means local, a URL means remote
# ORDERS_SOLVER_URL=   # remote: base URL of the solver service, e.g. http://solver.internal:8788
# ORDERS_SOLVER_TOKEN=   # remote: the same value as the service's SOLVER_AUTH_TOKEN (at least 32 characters). Set as a secret
# ORDERS_SOLVER_ADDRESS=   # remote: the solver's PUBLIC key (G...). The service must report the same one, or the API refuses to use it
# LOCAL mode runs the solver inside the API process, with its secret key here. For development and tests only: see README "Settlement orders".
# ORDERS_SOLVER_MODE=local
# ORDERS_SOLVER_SECRET=   # local: S... secret key of the solver account. It pays the fill's fees and holds the inventory it pays out. A throwaway testnet key only; set it as a secret, never commit it
# In local mode the recovery settings below apply to the in-process solver (a remote solver reads its own SOLVER_* copies):
# ORDERS_MAX_RETRIES=3   # re-quote-and-retry attempts per recovery cycle after a hedge fails
# ORDERS_MAX_LOSS_BPS=100   # largest loss a retried hedge may realise, in bps of the hedge proceeds it was priced on. Beyond it the position is left open, never dumped
# ORDERS_MAX_UNHEDGED_OUT=0   # circuit breaker: refuse new fills while unhedged positions are worth more than this (whole units of the asset paid out)
# ORDERS_RETRY_TICK_MS=15000   # how often the recovery loop wakes
# ORDERS_RETRY_BASE_MS=30000   # wait before the first automatic retry cycle; doubles each cycle up to ORDERS_RETRY_MAX_MS (default 600000)
# ORDERS_RETRY_MAX_CYCLES=12   # automatic retry cycles per position; then ABANDONED (open until an operator acts)

# Durable state of the solver (open positions, per-fill hedge status, which signatures were used): one JSON file, written atomically.
# Used by the solver service and by an in-process solver. Unset: memory only, lost on restart (the service refuses to run like that).
# SLUICE_STATE_DIR=   # a directory the solver process owns, e.g. /var/lib/sluice. Mode 0600 files. Back it up

# --- The standalone solver service (packages/solver): `pnpm build && pnpm solver`. Owns the key, runs fills and hedges, retries failed hedges.
# It refuses to start on the public network or with a weak token, and every route (health included) needs `Authorization: Bearer $SOLVER_AUTH_TOKEN`.
# SOLVER_SECRET=   # S... secret key of the solver account. Set as a secret; ideally behind a signer. A throwaway testnet key only
# SOLVER_AUTH_TOKEN=   # at least 32 random characters (openssl rand -hex 32), shared with the API's ORDERS_SOLVER_TOKEN
# SOLVER_SETTLE_CONTRACT=   # same contract as the API's ORDERS_SETTLE_CONTRACT
# SOLVER_RPC_URL=   # same network as the API's ORDERS_RPC_URL
# SOLVER_HORIZON_URL=   # same network as the API's ORDERS_HORIZON_URL
# SOLVER_NETWORK_PASSPHRASE=   # e.g. "Test SDF Network ; September 2015"
# SOLVER_PORT=8788
# SOLVER_HOST=127.0.0.1   # bind address. Keep it on a private network; the token is not a substitute for network isolation
# SOLVER_ALLOW_MEMORY_STATE=   # set 1 to run without SLUICE_STATE_DIR (throwaway runs only)
# The solver's own policy and recovery settings. The solver's copy is authoritative: the API prices with its ORDERS_* copy and the solver may still decline.
# SOLVER_MAX_ORDER_IN=1000
# SOLVER_HEDGE_SLIPPAGE_BPS=50
# SOLVER_MIN_PROFIT_BPS=20
# SOLVER_IMPROVEMENT_BPS=5000
# SOLVER_MIN_DEADLINE_BUFFER_SEC=60
# SOLVER_FEE_OUT_PER_XLM=0.1
# SOLVER_MAX_RETRIES=3
# SOLVER_MAX_LOSS_BPS=100
# SOLVER_MAX_UNHEDGED_OUT=0
# SOLVER_RETRY_TICK_MS=15000
# SOLVER_RETRY_BASE_MS=30000
# SOLVER_RETRY_MAX_MS=600000
# SOLVER_RETRY_MAX_CYCLES=12
