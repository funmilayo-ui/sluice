PORT=8787
HORIZON_URL=https://horizon.stellar.org
AQUARIUS_URL=https://amm-api.aqua.network
RPC_URL=https://mainnet.sorobanrpc.com   # Soroban quotes, simulation, submit and status. Public endpoint with unknown rate limits: use your own provider for real traffic.
SOURCE_TIMEOUT_MS=8000   # per venue; a cold process needs about 5s for its first quote
SLUICE_IPV4_FIRST=0   # set 1 if fetch fails with ETIMEDOUT (broken IPv6 route)
# SLUICE_DNS_CACHE=0   # turn off the in-process name-lookup cache and leave resolution entirely to the system
# SCORED_ASSETS=   # comma separated CODE:ISSUER stablecoins to score. Unset: USDC, PYUSD, USDGLO, ZUSD. Empty: scoring off.
# BLEND_POOLS=   # comma separated CONTRACT:Display name. Unset: the verified Blend Fixed Pool V2.
# DISABLED_VENUES=   # comma separated venue ids (classic-path, aquarius, soroswap, phoenix, comet) to switch off
SLUICE_ROUTER_CONTRACT=   # deployed Sluice router contract id; enables atomic multi-venue Soroban chains. Leave empty on mainnet: the contract is unaudited.
# VITE_REPO_URL=   # build-time, web app only: where the footer's "Source code" link points (default: github.com/funmilayo-ui/sluice)
# VITE_WALLETCONNECT_PROJECT_ID=   # build-time, web app only: a Reown (WalletConnect) project id; adds WalletConnect to the wallet list

# --- Settlement orders (testnet prototype). Off unless ALL of the first six are set. Separate from the mainnet settings above.
# The public network is refused (ORDERS_MAINNET_REFUSED) until the settle contract is audited: there is no override. See README "Settlement orders".
# ORDERS_SETTLE_CONTRACT=   # deployed contracts/settle id (C...)
# ORDERS_RPC_URL=   # Soroban RPC of the order network, e.g. https://soroban-testnet.stellar.org
# ORDERS_HORIZON_URL=   # Horizon of the same network, e.g. https://horizon-testnet.stellar.org. Prices the Classic hedge and reads trustlines
# ORDERS_NETWORK_PASSPHRASE=   # e.g. "Test SDF Network ; September 2015"
# ORDERS_SOLVER_SECRET=   # S... secret key of the solver account. It pays the fill's fees and holds the inventory it pays out. A throwaway testnet key only; set it as a secret, never commit it
# ORDERS_MAC_SECRET=   # at least 16 random characters; signs order ids so the server needs no database. Rotating it invalidates prepared orders
# ORDERS_FEE_OUT_PER_XLM=0.1   # token_out per 1 XLM, to price the solver's fees when it pays out a non-XLM asset (testnet has no market to read)
# ORDERS_MAX_ORDER_IN=1000   # largest order the solver takes on, in whole units of the asset sold
# ORDERS_HEDGE_SLIPPAGE_BPS=50   # assumed hedge slippage; also the hedge payment's on-chain minimum
# ORDERS_MIN_PROFIT_BPS=20   # profit the solver requires after fees, in bps of the hedge proceeds
# ORDERS_IMPROVEMENT_BPS=5000   # share of the surplus above the signed minimum that the solver hands to the user
# ORDERS_MIN_DEADLINE_BUFFER_SEC=60   # refuse an order with less than this left before its deadline
