{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api?__path=/v1/:path*" },
    { "source": "/health", "destination": "/api?__path=/health" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "content-security-policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https: wss:; frame-src https:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
        },
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "x-frame-options", "value": "DENY" },
        { "key": "referrer-policy", "value": "no-referrer" },
        { "key": "permissions-policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
